{
  // 复制此文件为 settings.json 后按需修改（settings.json 含个人配置，不入库）
  // 背景不透明度 (0.30 ~ 0.95)
  "tint": 0.72,
  // 高光描边强度 (0.0 ~ 0.40)
  "edge": 0.13,
  // 圆角半径（0 = 方角，150 = 半圆）
  "corner": 30,
  // 天气城市：留空 = 自动 IP 定位；街道级精度用空格分隔层级
  "city": "",
  // 是否显示天气（false = 背景保持整洁；开启后每 10 分钟拉取一次）
  "showWeather": false,
  // 背景图片路径（留空 = 渐变背景；也可拖图片到窗口 / 右键菜单选择）
  "bgImage": "",
  // 背景图缩放模式：fill 填充裁剪 / fit 适应留边 / stretch 拉伸 / tile 平铺
  "bgFit": "fill",
  // 背景图暗化遮罩强度（0.0 ~ 0.80，越大时间文字越清晰）
  "bgDim": 0.30,
  // 背景图模糊半径（0 ~ 30 像素）
  "bgBlur": 0.0,
  // 窗口置顶
  "topmost": false,
  // 显示秒
  "seconds": true,
  // 窗口位置（首次启动自动记忆，可留默认）
  "x": null,
  "y": null
}
